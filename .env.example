# Verix MVP — Environment Configuration
# Copy to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required: Active model available to your Anthropic account
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: path to the local, ignored FAERS SQLite snapshot
# FAERS_DB_PATH=data/faers.db

# Optional: Log level (default: INFO)
# LOG_LEVEL=INFO
